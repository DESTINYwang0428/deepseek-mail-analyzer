# ============ DeepSeek API ============
# 在 https://platform.deepseek.com 申请，形如 sk-xxxx
DEEPSEEK_API_KEY=sk-在此填入你的DeepSeekAPIKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ 邮箱（IMAP）============
# QQ: imap.qq.com / 163: imap.163.com / Gmail: imap.gmail.com / Outlook: outlook.office365.com
# 北邮（腾讯企业邮）: imap.exmail.qq.com 或 imap.bupt.edu.cn（SSL 993，用"客户端专用密码"）
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=you@example.com
# QQ/163/Gmail 等请填“授权码 / 应用专用密码”，不是登录密码！
IMAP_PASSWORD=你的IMAP授权码
IMAP_SSL=1
IMAP_FOLDER=INBOX

# ============ 第二个邮箱（可选；可继续加 MAILBOX3_ / MAILBOX4_ ...）============
# 一次运行会合并分析所有邮箱（同一份报告/弹窗）。例：北邮 bupt
# MAILBOX2_NAME=bupt
# MAILBOX2_IMAP_HOST=imap.exmail.qq.com
# MAILBOX2_IMAP_PORT=993
# MAILBOX2_IMAP_USER=yourid@bupt.edu.cn
# MAILBOX2_IMAP_PASSWORD=你的客户端专用密码
# MAILBOX2_IMAP_AUTH=password
# MAILBOX2_IMAP_FOLDER=INBOX
# 若第 2 个邮箱是 Outlook/Office365（OAuth），必须单独指定令牌文件避免互相覆盖：
# MAILBOX2_OAUTH_TOKEN_FILE=.outlook_oauth_2.json

# ============ 分析行为 ============
# 留空 = 今日 0 点起；填数字 = 最近 N 小时
LOOKBACK_HOURS=
MAX_EMAILS=100
# 重要度 >= 该值视为重要并输出原文
IMPORTANT_THRESHOLD=4
BATCH_SIZE=20
# 送入 API 的单封邮件正文上限（字符），调小更省 token
BODY_MAX=6000

# ============ 省 token ============
# 分析结果缓存文件（按 Message-ID 去重，重复运行不重复消耗 token）
CACHE_FILE=.mail_analyzer_state.json
# 缓存自动清理：超过该天数的旧记录每次运行时自动移除（--cache-clean 可手动清理）
CACHE_MAX_AGE_DAYS=30
# --important-only 时按发件人域名关键字预过滤（逗号分隔）
SKIP_SENDERS=newsletter,weekly,digest,promo,bounce,unsubscribe,mailer,edm,marketing

# ============ 费用估算（元/百万 tokens，deepseek V4-Flash 空闲时段价）============
# 高峰时段（每天 9:00-14:00）约翻倍；仅用于脚本末尾的费用估算显示
DEEPSEEK_PRICE_INPUT=1.5
DEEPSEEK_PRICE_OUTPUT=4.5

# ============ 桌面报告（--desktop-report / --popup）============
# 报告保存目录，默认 ~/Desktop
DESKTOP_DIR=~/Desktop
